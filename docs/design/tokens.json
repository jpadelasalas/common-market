{
  "meta": {
    "name": "Common Market",
    "version": "0.1",
    "status": "applied Pencil design; responsive and behavior specifications await implementation",
    "theme": "light"
  },
  "color": {
    "background": {
      "$type": "color",
      "$value": "#F8F7F4"
    },
    "surface": {
      "$type": "color",
      "$value": "#FFFFFF"
    },
    "subtle": {
      "$type": "color",
      "$value": "#EEECE6"
    },
    "border": {
      "$type": "color",
      "$value": "#DCD9D0"
    },
    "controlBorder": {
      "$type": "color",
      "$value": "#807C73"
    },
    "text": {
      "$type": "color",
      "$value": "#202722"
    },
    "textSecondary": {
      "$type": "color",
      "$value": "#596258"
    },
    "textInverse": {
      "$type": "color",
      "$value": "#FFFFFF"
    },
    "primary": {
      "$type": "color",
      "$value": "#23553B"
    },
    "primaryHover": {
      "$type": "color",
      "$value": "#19412D"
    },
    "primarySoft": {
      "$type": "color",
      "$value": "#E8EFE9"
    },
    "error": {
      "$type": "color",
      "$value": "#A12B2B"
    },
    "errorSoft": {
      "$type": "color",
      "$value": "#FBEFEE"
    },
    "warning": {
      "$type": "color",
      "$value": "#795313"
    },
    "warningSoft": {
      "$type": "color",
      "$value": "#FAF1DE"
    },
    "info": {
      "$type": "color",
      "$value": "#24526F"
    },
    "infoSoft": {
      "$type": "color",
      "$value": "#EDF3F8"
    }
  },
  "typography": {
    "family": {
      "sans": "Geist Sans, system-ui, sans-serif",
      "mono": "Geist Mono, ui-monospace, monospace"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "scale": {
      "caption": {
        "size": 12,
        "lineHeight": 18
      },
      "label": {
        "size": 14,
        "lineHeight": 20
      },
      "body": {
        "size": 16,
        "lineHeight": 24
      },
      "section": {
        "size": 22,
        "lineHeight": 30
      },
      "headingMobile": {
        "size": 26,
        "lineHeight": 32
      },
      "headingDesktop": {
        "size": 32,
        "lineHeight": 40
      }
    },
    "numerals": "tabular-nums"
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "radius": {
    "small": 4,
    "medium": 8,
    "pill": 999
  },
  "layout": {
    "desktopFrame": 1440,
    "mobileFrame": 390,
    "contentMax": 1312,
    "mobileGutter": 16,
    "tabletGutter": 24,
    "operationsNav": 224,
    "productPhotoHeight": { "desktop": 290, "mobile": 210 },
    "breakpoints": {
      "mobileMax": 767,
      "tabletMax": 1199
    }
  },
  "control": {
    "height": 44,
    "compactDesktopHeight": 36,
    "focusWidth": 2,
    "focusOffset": 2
  },
  "motion": {
    "feedbackMs": 120,
    "disclosureMs": 200,
    "easing": "ease-out",
    "reducedMotion": "disable nonessential transitions"
  },
  "elevation": {
    "overlay": "0 8px 24px rgba(32,39,34,0.12)"
  },
  "contrastPairs": [
    {
      "name": "Primary text on background",
      "foreground": "text",
      "background": "background",
      "min": 4.5
    },
    {
      "name": "Secondary text on background",
      "foreground": "textSecondary",
      "background": "background",
      "min": 4.5
    },
    {
      "name": "White on primary action",
      "foreground": "textInverse",
      "background": "primary",
      "min": 4.5
    },
    {
      "name": "White on primary hover",
      "foreground": "textInverse",
      "background": "primaryHover",
      "min": 4.5
    },
    {
      "name": "Error on error surface",
      "foreground": "error",
      "background": "errorSoft",
      "min": 4.5
    },
    {
      "name": "Warning on warning surface",
      "foreground": "warning",
      "background": "warningSoft",
      "min": 4.5
    },
    {
      "name": "Information on information surface",
      "foreground": "info",
      "background": "infoSoft",
      "min": 4.5
    },
    {
      "name": "Control border on white",
      "foreground": "controlBorder",
      "background": "surface",
      "min": 3
    },
    {
      "name": "Focus ring on background",
      "foreground": "primary",
      "background": "background",
      "min": 3
    }
  ]
}
